# Rendered from the template at container start: envsubst over ${UPSTREAM_*} and
# ${API_BASE_PATH} produces /etc/nginx/conf.d/default.conf.
#
# The security headers here are the ones that only a proxy can set correctly for the
# whole origin. The API sets its own (helmet / Spring Security) for /api responses.

server {
  listen 8080;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  # Never advertise the server version.
  server_tokens off;

  # A SPA has no server-side routing, so any unknown path must fall back to
  # index.html for the client router. `try_files` rather than an error page so a
  # deep link (/chat/abc) is shareable.
  location / {
    try_files $uri $uri/ /index.html;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()" always;
    # CSP for the document itself. 'unsafe-inline' is NOT used: Vite emits a
    # single style block for the Tailwind preflight, which is inlined at build
    # time, so the hash below is what makes that legal without weakening the rest.
    # Adjust the hash if the build output changes, or move the block to a file.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'" always;
  }

  # Hashed asset filenames are immutable by construction, so they may be cached for
  # a year. index.html must never be cached, or a deploy leaves clients on a stale
  # bundle pointing at removed asset hashes.
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    access_log off;
  }
  location = /index.html {
    add_header Cache-Control "no-store, must-revalidate";
  }

  # The API. Same-origin from the browser's point of view, so the frontend needs no
  # CORS exception in production and the refresh cookie stays First-Party.
  location ${API_BASE_PATH} {
    proxy_pass http://${UPSTREAM_HOST}:${UPSTREAM_PORT};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    # The backend trusts these to record the caller's IP for lockout and audit; a
    # client cannot forge them because it never reaches the backend directly.
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # SSE. Buffering off or the answer arrives all at once; a long read timeout or
    # the proxy cuts the stream mid-answer.
    proxy_set_header Connection '';
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 1h;
    chunked_transfer_encoding on;
  }

  # Health probes are polled by compose; keep them out of the access log.
  location = ${API_BASE_PATH}/health {
    proxy_pass http://${UPSTREAM_HOST}:${UPSTREAM_PORT};
    access_log off;
  }

  # Uploads of source documents are capped well below the default; a larger body than
  # this is a client bug or an attack, and refusing it at the edge keeps it away from
  # the JVM's parsers.
  client_max_body_size 25m;
}
