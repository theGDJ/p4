# BIS-Saathi — environment template
# Copy to `.env` and fill in. Never commit `.env` (see .gitignore).
# Every value below has a working default except the secrets marked REQUIRED.

# ---------- runtime profile ----------
# `mock`  = runnable in this repo without Docker/JDK/Postgres (mock-api/, Node).
# `spring`= the real Java backend in backend/ (needs JDK 21 + Docker + Postgres + Redis).
APP_STACK=mock
APP_ENV=development

# ---------- shared ----------
# API_BASE_PATH is the single HTTP prefix for both backends and for the frontend's
# nginx proxy. It is fixed in application code (docs/API.md is the contract); this
# entry exists so the compose template and the frontend proxy agree.
API_BASE_PATH=/api/v1
# Host ports. Inside the network both backends listen on 8080 (SERVER_PORT is set by
# docker-compose and is not meant to be changed from here).
PORT_BACKEND=8080
PORT_MOCK_API=8081
PORT_FRONTEND=5173

# ---------- auth / secrets ----------
# REQUIRED in any non-local deployment. Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-min-32-bytes-long-please
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=14
# There is deliberately no refresh secret: refresh tokens are opaque random strings
# compared by SHA-256 digest, not signed tokens, so nothing needs a shared key.
# Cookie flags for the refresh token. Secure must stay true behind HTTPS.
COOKIE_SECURE=true
COOKIE_SAME_SITE=Lax
COOKIE_DOMAIN=
# Argon2id parameters (OWASP-ish defaults). m=memory KiB, t=iterations, p=parallelism
ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1
# Account lockout
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ---------- backend (Spring) auth internals ----------
# Fixed by docs/API.md; changing either invalidates issued tokens, which is fine
# before a deployment but is not a rolling-change knob.
JWT_ISSUER=bis-saathi
JWT_AUDIENCE=bis-saathi-web
# HikariCP pool ceiling. Size it against `max_connections` on Postgres, not on core
# count: N replicas x this value must stay under the server limit.
DB_POOL_MAX=10

# ---------- development seed accounts ----------
# Creates admin@ / content@ / demo@example.org on an empty database. Both guards must
# be satisfied: the property AND a non-production profile, and the backend refuses to
# boot with seeding enabled under prod. Leave SEED_DEMO_PASSWORD empty to have one
# generated and printed once to the container log.
SEED_DEMO_USERS=false
SEED_DEMO_PASSWORD=

# ---------- rate limiting ----------
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_AUTH_MAX=10

# ---------- CORS / CSRF ----------
# Comma-separated allowlist. No wildcards in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_ENABLED=true

# ---------- postgres + pgvector ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bissaathi
POSTGRES_USER=bissaathi
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_IMAGE=pgvector/pgvector:pg17
# HNSW index params
PGVECTOR_HNSW_M=16
PGVECTOR_HNSW_EF_CONSTRUCTION=64
PGVECTOR_DIMENSIONS=1024

# ---------- redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_IMAGE=redis:7.4-alpine
REDIS_PASSWORD=

# ---------- LLM / embedding providers (§3, §9) ----------
# `mock-api` accepts exactly two names here: `mock` (offline, the default) and
# `openai-compatible`, which covers OpenAI itself and any gateway speaking
# /chat/completions + /embeddings (vLLM, Ollama, Azure's compatibility endpoint,
# Gemini's /v1beta/openai). The Spring backend additionally understands the vendor
# SDK names below. A non-mock provider with no base URL/key is a fatal boot error in
# both stacks — never a silent fallback to the mock, which would make a broken
# deployment look exactly like a working one.
#   mock | openai-compatible            (mock-api)
#   mock | openai | azure_openai | anthropic | gemini | ollama   (Spring)
LLM_PROVIDER=mock
LLM_SMALL_MODEL=mock-small
LLM_LARGE_MODEL=mock-large
LLM_BASE_URL=
LLM_API_KEY=
# 1000..180000. A timeout below one second is a bug, not a setting, so the floor is
# enforced at boot.
LLM_TIMEOUT_MS=45000
LLM_MAX_RETRIES=2
# Costs are reported only when priced. Leave these empty and `costUsd` is null, which
# the UI renders as "no cost data" rather than as free (R10).
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=

EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=mock-multilingual-1
EMBEDDING_API_KEY=
# Must match `knowledge_chunks.embedding vector(1024)` in V1__init.sql. Changing it
# means re-embedding every approved chunk, not just restarting.
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BASE_URL=
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_MS=30000
EMBEDDING_MAX_RETRIES=2
EMBEDDING_PRICE_PER_MTOK=

# Runtime budget (§9) — Spring reads these; mock-api has the same numbers built in and
# documents them in docs/ENVIRONMENT.md so the two stacks stay comparable.
RAG_CONTEXT_MAX_TOKENS=3000
RAG_TOP_K_RETRIEVE=30
RAG_TOP_K_FINAL=6
RAG_SUMMARY_MAX_TOKENS=150
RAG_HISTORY_TURNS=4

# ---------- answer cache (§9, mock-api) ----------
# The semantic answer cache. A turn is cacheable only when it is impersonal, has no
# conversation history, produced evidence, and hit no provider error — so this block
# cannot serve one person's context to another. Keys carry the knowledge-base version,
# so approving or rejecting a chunk invalidates what quoted it.
ANSWER_CACHE_ENABLED=true
# Floor 10s, ceiling 24h: a TTL of 0 would make a "cache" a source of flaky answers.
ANSWER_CACHE_TTL_SECONDS=900
ANSWER_CACHE_MAX_ENTRIES=500
# The equivalent Spring knobs. The mock's similarity threshold is fixed at 0.94 and is
# not configurable — measured on the offline trigram embeddings, where 0.94 already
# admits two different questions (see docs/ENVIRONMENT.md), so tune it only with real
# multilingual embeddings in place.
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_SIMILARITY=0.94

# ---------- knowledge / ingestion (§5) ----------
KNOWLEDGE_MANIFEST_PATH=knowledge/manifest.csv
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=26214400
UPLOAD_ALLOWED_EXTENSIONS=.pdf,.html,.htm,.txt,.md,.csv
# Fetched-page limits. INGEST_MAX_BYTES is enforced while streaming, not from
# Content-Length, so a server that lies about its size is cut off rather than trusted.
INGEST_MAX_BYTES=25000000
INGEST_TIMEOUT_MS=20000
INGEST_MAX_REDIRECTS=3
INGEST_MAX_PAGES=120
INGEST_USER_AGENT=BIS-Saathi-knowledge-ingestion/0.1
# SSRF gate. Loopback, RFC1918, link-local and every IPv6 form that hides an IPv4
# address are refused. Flipping this to true lets the fetcher reach private networks:
# it exists so the pipeline can be tested against a local fixture, and it is a fatal
# boot error under NODE_ENV=production. Docs: docs/SECURITY.md §9.
INGEST_ALLOW_PRIVATE_NETWORKS=false
# Chunking of extracted text. Overlap is a fraction of the target size, so a clause
# split across a boundary still appears whole in at least one chunk.
CHUNK_MIN_TOKENS=300
CHUNK_MAX_TOKENS=500
CHUNK_OVERLAP_RATIO=0.1

# ---------- password reset mail (mock-api) ----------
# `log` prints the message and records that it was sent; `none` records that nothing
# was sent; `smtp` really sends. The API never claims a delivery the transport did not
# make, so with `none` a reset request replies "no mail could be sent" instead of
# pretending (R8). Production refuses to boot on anything but `smtp`.
MAIL_TRANSPORT=log
SMTP_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
MAIL_SUBJECT_PREFIX=[BIS-Saathi]
# Absolute base used to build the reset link in the mail body. Without it the mail
# states the token instead of a link, which still works but reads worse.
APP_PUBLIC_URL=

# ---------- observability ----------
LOG_LEVEL=INFO
LOG_FORMAT=json
# Redact PII before logging (§8)
LOG_PII_REDACTION=true
